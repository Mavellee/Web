# Copy to web/.env.local (git-ignored). These are the PUBLIC Firebase web config values — safe to ship in the
# bundle, they only identify which Firebase project to talk to. They came from the Firebase console:
# Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
