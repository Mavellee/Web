# Copy to .env.local (git-ignored) and fill in. Every variable here is validated at startup by
# src/env.server.ts / src/env.public.ts, so a typo fails loudly instead of silently.
#
# Staging and production values live in Vercel (Project > Settings > Environment Variables),
# NOT in files. See docs/04-environments-and-deployment.md.

# --- Which environment is this? (local | staging | production) ---
APP_ENV=local

# --- Public (shipped to the browser; never put secrets here) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Local Docker database from `npm run db:up` (port 5433 so it never clashes with a Postgres you installed yourself):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/iceberg
# Staging / production: use the Supabase *pooler* connection string (port 6543, "transaction" mode), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DB_POOL_MAX=5
# DB_SSL=auto            # auto | require | disable
# DB_SSL_CA=             # optional PEM of the database CA to fully verify TLS

# --- Logging (optional; defaults: debug locally, info elsewhere) ---
# LOG_LEVEL=debug
